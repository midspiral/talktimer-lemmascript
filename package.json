{
  "name": "talktimer-lemmascript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "vite": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen": "npx tsx ../LemmaScript/tools/src/lsc.ts gen --backend=dafny src/domain.ts",
    "check": "npx tsx ../LemmaScript/tools/src/lsc.ts check --backend=dafny src/domain.ts",
    "regen": "npx tsx ../LemmaScript/tools/src/lsc.ts regen --backend=dafny src/domain.ts",
    "check:proofs": "./check-extra.sh"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
